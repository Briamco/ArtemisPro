@model Application.Models.ViewModels.Admin.CreditCardDetailsViewModel
@{
    ViewData["Title"] = "Detalles de Tarjeta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .module-container { background-color: var(--bg-main); min-height: 100%; padding-top: 10px; }
    
    .graphic-card { background-color: #2A303C; background-image: linear-gradient(135deg, #2A303C 0%, #1A1F29 100%); border-radius: 16px; padding: 25px; width: 420px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); position: relative; overflow: hidden; margin-bottom: 30px; border: 1px solid rgba(255,255,255,0.05); }
    .graphic-card::before { content: ""; position: absolute; top: -50px; right: -50px; width: 150px; height: 150px; border-radius: 50%; background: rgba(255,255,255,0.02); }
    
    .card-label { font-size: 0.65rem; color: #8A92A6; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; }
    .card-value { font-size: 0.9rem; color: white; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
    .card-number { font-family: 'Courier New', Courier, monospace; font-size: 1.6rem; color: white; letter-spacing: 4px; margin: 25px 0; font-weight: bold; text-shadow: 0 2px 4px rgba(0,0,0,0.5); }
    
    .consumptions-container { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 25px; }
    
    .custom-table { width: 100%; color: white; border-collapse: separate; border-spacing: 0 15px; }
    .custom-table th { color: var(--text-muted); font-size: 0.8rem; font-weight: 700; padding: 0 15px 10px 15px; border-bottom: 1px solid var(--border-color); }
    .custom-table td { padding: 15px; font-size: 0.95rem; vertical-align: middle; border-bottom: 1px solid rgba(255,255,255,0.03); }
    
    .status-badge { padding: 6px 14px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; display: inline-flex; align-items: center; gap: 6px; letter-spacing: 0.5px; }
    .badge-approved { border: 1px solid var(--cyan-accent); color: var(--cyan-accent); background-color: rgba(0, 229, 255, 0.05); }
    .badge-rejected { border: 1px solid #FF6B6B; color: #FF6B6B; background-color: rgba(255, 107, 107, 0.05); }
    
    .commerce-icon { width: 32px; height: 32px; background-color: rgba(255,255,255,0.05); border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; margin-right: 12px; color: var(--text-muted); }
</style>

<div class="module-container">
    <div class="mb-4">
        <a asp-action="CreditCardManagement" style="color: white; text-decoration: none; display: flex; align-items: center; gap: 8px; margin-bottom: 20px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg> Volver atrás
        </a>
        <h2 style="font-weight: 700; font-size: 2.2rem; color: white;">Detalles de Tarjeta</h2>
    </div>

    <!-- Réplica de la Tarjeta Gráfica -->
    <div class="graphic-card">
        <div class="d-flex justify-content-between align-items-start">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0"></path><path d="M1.42 9a16 16 0 0 1 21.16 0"></path><path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path><line x1="12" y1="20" x2="12.01" y2="20"></line></svg>
            <div style="text-align: right;">
                <div style="font-size: 0.8rem; color: white; letter-spacing: 2px; font-weight: 600;">ARTEMIS</div>
                <div style="font-size: 0.8rem; color: #8A92A6; letter-spacing: 2px;">ELITE</div>
            </div>
        </div>
        
        <div style="margin-top: 25px;">
            <div class="card-label">Número de Tarjeta</div>
            <div class="card-number">@Model.MaskedNumber</div>
        </div>
        
        <div class="d-flex justify-content-between align-items-end mt-4">
            <div>
                <div class="card-label">Titular</div>
                <div class="card-value">@Model.ClientName</div>
            </div>
            <div style="text-align: right;">
                <div class="card-label">Expira</div>
                <div class="card-value">@Model.ExpirationDate</div>
            </div>
        </div>
    </div>

    <!-- Lista de Consumos -->
    <div class="consumptions-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 style="color: white; font-weight: 700; font-size: 1.3rem;">Consumos Recientes</h5>
            <a href="#" style="color: var(--text-muted); font-size: 0.8rem; font-weight: 600; text-decoration: none; letter-spacing: 1px;">VER TODOS &gt;</a>
        </div>

        <table class="custom-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Comercio</th>
                    <th>Monto</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var consumo in Model.Consumptions)
                {
                    <tr>
                        <td style="color: var(--text-muted);">@consumo.Date.ToString("dd MMM yyyy")</td>
                        <td style="color: white; font-weight: 600; display: flex; align-items: center;">
                            <span class="commerce-icon">
                                @if (consumo.Commerce.Contains("VIRTUAL") || consumo.Commerce.Contains("Apple")) { <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg> }
                                else if (consumo.Commerce.Contains("EFECTIVO")) { <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"></rect><circle cx="12" cy="12" r="2"></circle><path d="M6 12h.01M18 12h.01"></path></svg> }
                                else if (consumo.Commerce.Contains("Aerolíneas")) { <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg> }
                                else { <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="1" x2="6" y2="4"></line><line x1="10" y1="1" x2="10" y2="4"></line><line x1="14" y1="1" x2="14" y2="4"></line></svg> }
                            </span>
                            @consumo.Commerce
                        </td>
                        <td style="color: white; font-weight: 600;">$ @consumo.Amount.ToString("N2")</td>
                        <td>
                            @if (consumo.Status == "APROBADO")
                            {
                                <span class="status-badge badge-approved">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> APROBADO
                                </span>
                            }
                            else
                            {
                                <span class="status-badge badge-rejected">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg> RECHAZADO
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>