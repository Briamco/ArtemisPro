@model Application.Models.ViewModels.Admin.EditLoanRateViewModel
@{
    ViewData["Title"] = "Editar Tasa de Préstamo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .module-container { background-color: var(--bg-main); min-height: 100%; }
    .form-card { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 30px; max-width: 500px; margin-top: 30px; }
    .custom-label { color: white; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; display: block; }
    .custom-input { background-color: #080D17; border: 1px solid var(--border-color); color: white; padding: 12px 16px; border-radius: 8px; width: 100%; outline: none; }
    .custom-input:focus { border-color: var(--cyan-accent); }
    .btn-outline { background-color: transparent; color: white; border: 1px solid var(--border-color); padding: 12px 24px; border-radius: 8px; font-weight: 600; text-decoration: none; }
    .btn-next { background-color: var(--cyan-accent); color: #000; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 600; cursor: pointer; }
</style>

<div class="module-container">
    <div>
        <h2 style="font-weight: 700; font-size: 2.2rem; margin-bottom: 8px;">Editar Tasa de Interés</h2>
        <p style="color: var(--text-muted); font-size: 1rem;">Modifique la tasa del préstamo. Se recalcularán las cuotas futuras.</p>
    </div>

    <div class="form-card">
        <form asp-action="EditLoanRate" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-4">
                <label class="custom-label" asp-for="InterestRate">Nueva tasa de interés anual (%)</label>
                <div style="position: relative;">
                    <input asp-for="InterestRate" type="number" step="0.01" class="custom-input" style="padding-right: 40px;" />
                    <span style="position: absolute; right: 15px; top: 12px; color: var(--text-muted); font-weight: 600;">%</span>
                </div>
                <span asp-validation-for="InterestRate" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="d-flex justify-content-end gap-3">
                <a asp-action="LoanManagement" class="btn-outline">Volver atrás</a>
                <button type="submit" class="btn-next">Modificar tasa</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}