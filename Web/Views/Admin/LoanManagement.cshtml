@model Application.Models.ViewModels.Admin.LoanListViewModel
@{
    ViewData["Title"] = "Gestión de Préstamos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .module-container { background-color: var(--bg-main); min-height: 100%; }
    .table-container { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; }
    .filter-bar { background-color: #141C2B; border: 1px solid var(--border-color); border-radius: 12px; padding: 15px 24px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
    
    .search-input { background-color: #080D17; border: 1px solid var(--border-color); color: white; padding: 10px 15px 10px 40px; border-radius: 8px; outline: none; width: 300px; }
    .custom-select { background-color: #0B101E; color: white; border: 1px solid var(--border-color); padding: 8px 16px; border-radius: 6px; outline: none; }
    
    .custom-table { width: 100%; color: white; border-collapse: separate; border-spacing: 0 15px; }
    .custom-table th { color: var(--text-muted); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; padding: 0 15px 10px 15px; border-bottom: 1px solid var(--border-color); }
    .custom-table td { padding: 15px; background-color: #0B101E; font-size: 0.9rem; vertical-align: middle; }
    .custom-table tr td:first-child { border-top-left-radius: 8px; border-bottom-left-radius: 8px; font-weight: 600; color: var(--cyan-accent); }
    .custom-table tr td:last-child { border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
    
    .btn-create { background-color: var(--cyan-accent); color: #000; font-weight: 600; padding: 10px 24px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
    .btn-create:hover { background-color: #00B8CC; color: #000; }
    
    .badge-status { padding: 4px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; border: 1px solid; text-align: center; display: inline-block; width: 85px; margin-bottom: 4px;}
    .badge-activo { border-color: rgba(0, 229, 255, 0.4); color: var(--cyan-accent); background-color: rgba(0, 229, 255, 0.05); }
    .badge-completado { border-color: var(--text-muted); color: var(--text-muted); background-color: transparent; }
    
    .badge-aldia { border-color: transparent; color: #8A99AF; background-color: rgba(255, 255, 255, 0.05); font-size: 0.7rem;}
    .badge-mora { border-color: transparent; color: #FF6B6B; background-color: rgba(255, 107, 107, 0.1); font-size: 0.7rem;}

    .progress-bar-bg { background-color: #1F2A3D; height: 6px; border-radius: 3px; width: 60px; display: inline-block; margin-left: 10px; }
    .progress-bar-fill { background-color: var(--cyan-accent); height: 100%; border-radius: 3px; }
</style>

<div class="module-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="background-color: rgba(0, 229, 255, 0.1); border: 1px solid var(--cyan-accent); color: var(--cyan-accent); border-radius: 8px; padding: 15px; margin-bottom: 24px;">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 style="font-weight: 700; font-size: 2.2rem; margin-bottom: 8px;">Gestión de Préstamos</h2>
            <p style="color: var(--text-muted); font-size: 1rem;">Administra y asigna préstamos a clientes</p>
        </div>
        <a asp-action="AssignLoanStep1" class="btn-create">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Asignar préstamo
        </a>
    </div>

    <div class="filter-bar">
        <form asp-action="LoanManagement" method="get" id="filterForm" class="d-flex w-100 justify-content-between">
            <div style="position: relative;">
                <svg style="position: absolute; left: 12px; top: 12px; color: var(--text-muted);" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input type="text" name="searchCedula" class="search-input" placeholder="Buscar por cédula..." value="@Model.SearchCedula" onblur="document.getElementById('filterForm').submit();" />
            </div>
            <div class="d-flex align-items-center gap-3">
                <span style="color: var(--text-muted); font-weight: 600;">Estado:</span>
                <select class="custom-select" name="statusFilter" onchange="document.getElementById('filterForm').submit();">
                    <option value="Todos" selected="@(Model.CurrentFilter == "Todos")">Todos</option>
                    <option value="Activos" selected="@(Model.CurrentFilter == "Activos")">Activos</option>
                    <option value="Completados" selected="@(Model.CurrentFilter == "Completados")">Completados</option>
                </select>
            </div>
        </form>
    </div>

    @if (ViewBag.SearchMessage != null)
    {
        <div class="alert alert-warning" style="background-color: rgba(255, 171, 0, 0.1); border: 1px solid #FFAB00; color: #FFAB00; border-radius: 8px;">
            @ViewBag.SearchMessage
        </div>
    }

    <div class="table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>N° Préstamo</th>
                    <th>Cliente</th>
                    <th>Capital Aprobado</th>
                    <th>Cuotas</th>
                    <th>Monto Pendiente</th>
                    <th>Tasa / Plazo</th>
                    <th>Estado</th>
                    <th>Acciones</th> 
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in Model.Loans)
                {
                    <tr>
                        <td>@loan.LoanNumber</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width: 32px; height: 32px; border-radius: 50%; background-color: #1A2436; color: var(--text-muted); display: flex; justify-content: center; align-items: center; font-size: 0.8rem; font-weight: bold;">
                                    @(loan.ClientName.Substring(0,1))C
                                </div>
                                <div>
                                    <div style="font-weight: 600; color: white;">@loan.ClientName</div>
                                    <div style="font-size: 0.75rem; color: var(--text-muted);">ID: @loan.ClientCedula</div>
                                </div>
                            </div>
                        </td>
                        <td>@loan.ApprovedCapital.ToString("C")</td>
                        <td>
                            <span style="color: var(--cyan-accent); font-weight: 600;">@loan.PaidInstallments</span> / <span style="color: var(--text-muted);">@loan.TotalInstallments</span>
                            <div class="progress-bar-bg">
                                <div class="progress-bar-fill" style="width: @((double)loan.PaidInstallments / loan.TotalInstallments * 100)%"></div>
                            </div>
                        </td>
                        <td style="color: @(loan.PendingAmount > 0 ? "#FF6B6B" : "var(--text-muted)"); font-weight: 600;">@loan.PendingAmount.ToString("C")</td>
                        <td>
                            <div>@loan.InterestRate.ToString("0.0")%</div>
                            <div style="font-size: 0.75rem; color: var(--text-muted);">@loan.TermInMonths Meses</div>
                        </td>
                        <td>
                            <div class="d-flex flex-column align-items-start gap-1">
                                <span class="badge-status @(loan.LoanStatus == "Activo" ? "badge-activo" : "badge-completado")">@loan.LoanStatus</span>
                                @if (loan.LoanStatus == "Activo")
                                {
                                    <span class="badge-status @(loan.ClientStatus == "Al día" ? "badge-aldia" : "badge-mora")">@loan.ClientStatus</span>
                                }
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <!-- Ver Detalles -->
                                <a asp-action="LoanDetails" asp-route-id="@loan.Id" style="color: var(--text-muted);" title="Ver detalles">
                                   <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                               </a>
                                <!-- Editar -->
                                <a asp-action="EditLoanRate" asp-route-id="@loan.Id" style="color: var(--cyan-accent);" title="Editar Tasa">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        
        <div class="d-flex justify-content-between align-items-center mt-4" style="color: var(--text-muted); font-size: 0.9rem;">
            <div>Mostrando 1 a @Model.Loans.Count de @Model.TotalRecords préstamos</div>
            <div class="d-flex gap-2">
                <span style="background-color: transparent; border: 1px solid var(--border-color); padding: 5px 12px; border-radius: 4px; cursor: pointer;">&lt;</span>
                <span style="background-color: rgba(0, 229, 255, 0.1); color: var(--cyan-accent); border: 1px solid var(--cyan-accent); padding: 5px 12px; border-radius: 4px; font-weight: 600;">1</span>
                <span style="padding: 5px 12px; cursor: pointer;">2</span>
                <span style="padding: 5px 12px; cursor: pointer;">3</span>
                <span style="padding: 5px 12px;">...</span>
                <span style="background-color: transparent; border: 1px solid var(--border-color); padding: 5px 12px; border-radius: 4px; cursor: pointer;">&gt;</span>
            </div>
        </div>
    </div>
</div>