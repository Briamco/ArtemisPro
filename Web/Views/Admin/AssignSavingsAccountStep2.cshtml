@model Application.Models.ViewModels.Admin.AssignSavingsAccountStep2ViewModel
@{
    ViewData["Title"] = "Asignar Cuenta - Paso 2";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .module-container { background-color: var(--bg-main); min-height: 100%; }
    .form-card { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 30px; max-width: 600px; margin-top: 20px;}
    
    .client-header { background-color: #0B101E; border-radius: 8px; padding: 20px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px; border: 1px solid var(--border-color); }
    
    .custom-label { color: white; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; display: block; }
    .custom-input { background-color: #080D17; border: 1px solid var(--border-color); color: white; padding: 12px 16px; border-radius: 8px; width: 100%; outline: none; font-size: 1.1rem;}
    .custom-input:focus { border-color: var(--cyan-accent); }
    
    .btn-outline { background-color: transparent; color: white; border: 1px solid var(--border-color); padding: 12px 24px; border-radius: 8px; font-weight: 600; text-decoration: none; }
    .btn-next { background-color: var(--cyan-accent); color: #000; border: none; padding: 12px 30px; border-radius: 8px; font-weight: 600; cursor: pointer; }
</style>

<div class="module-container">
    <div class="mb-4">
        <h2 style="font-weight: 700; font-size: 2.2rem; margin-bottom: 8px;">Configurar Cuenta Secundaria</h2>
        <p style="color: var(--text-muted); font-size: 1rem;">Establezca el balance inicial para la nueva cuenta de ahorro.</p>
    </div>

    <div class="form-card">
        <div style="font-size: 0.75rem; color: white; font-weight: 700; text-transform: uppercase; margin-bottom: 15px; letter-spacing: 1px;">DATOS DEL CLIENTE</div>
        <div class="client-header">
            <div class="d-flex align-items-center gap-3">
                <div style="width: 50px; height: 50px; border-radius: 50%; background-color: #1A2436; color: var(--text-muted); display: flex; align-items: center; justify-content: center;"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></div>
                <div>
                    <div style="font-size: 1.2rem; font-weight: 600; color: white;">@Model.ClientName</div>
                    <div style="font-size: 0.85rem; color: var(--text-muted);">ID: @Model.ClientCedula</div>
                </div>
            </div>
            <span style="background-color: rgba(0, 229, 255, 0.1); color: var(--cyan-accent); font-size: 0.75rem; font-weight: 600; padding: 6px 12px; border-radius: 20px;">Cuenta Secundaria</span>
        </div>

        <form asp-action="AssignSavingsAccountStep2" method="post">
            <input type="hidden" asp-for="ClientId" />
            <input type="hidden" asp-for="ClientName" />
            <input type="hidden" asp-for="ClientCedula" />
            
            <div class="mb-4">
                <label class="custom-label" asp-for="InitialBalance">Balance Inicial (RD$)</label>
                <div style="position: relative;">
                    <span style="position: absolute; left: 15px; top: 12px; color: white; font-weight: 600; font-size: 1.1rem;">$</span>
                    <input asp-for="InitialBalance" type="number" step="0.01" class="custom-input" style="padding-left: 35px;" placeholder="0.00" />
                </div>
                <span asp-validation-for="InitialBalance" class="text-danger" style="font-size: 0.8rem; display: block; margin-top: 5px;"></span>
                <p style="color: var(--text-muted); font-size: 0.75rem; margin-top: 8px;">Puede ser RD$0.00. Si es mayor, se registrará una transacción inicial de CRÉDITO.</p>
            </div>

            <div class="d-flex justify-content-end gap-3 mt-4 pt-4 border-top" style="border-color: var(--border-color) !important;">
                <a asp-action="AssignSavingsAccountStep1" class="btn-outline">Volver atrás</a>
                <button type="submit" class="btn-next">Asignar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }