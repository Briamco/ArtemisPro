@model Application.Models.ViewModels.Admin.AssignCardStep1ViewModel
@{
    ViewData["Title"] = "Asignar Tarjeta - Paso 1";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .module-container { background-color: var(--bg-main); min-height: 100%; }
    .info-card { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; flex: 1; }
    
    .btn-outline { background-color: transparent; color: white; border: 1px solid var(--border-color); padding: 12px 24px; border-radius: 8px; font-weight: 600; text-decoration: none; display: flex; align-items: center; justify-content: center; }
    .btn-next { background-color: var(--cyan-accent); color: #000; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px; justify-content: center;}
    
    .custom-table { width: 100%; color: white; border-collapse: separate; border-spacing: 0 15px; }
    .custom-table th { color: var(--text-muted); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; padding: 0 15px 10px 15px; border-bottom: 1px solid var(--border-color); }
    .custom-table td { padding: 15px; background-color: #0B101E; font-size: 0.9rem; vertical-align: middle; }
    .custom-table tr td:first-child { border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
    .custom-table tr td:last-child { border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
    
    .custom-radio { position: relative; padding-left: 30px; cursor: pointer; user-select: none; display: inline-flex; align-items: center; margin-bottom: 0; min-height: 20px; }
    .custom-radio input { position: absolute; opacity: 0; cursor: pointer; }
    .checkmark { position: absolute; top: 50%; transform: translateY(-50%); left: 0; height: 20px; width: 20px; background-color: transparent; border: 2px solid var(--border-color); border-radius: 50%; }
    .custom-radio:hover input ~ .checkmark { border-color: var(--cyan-accent); }
    .custom-radio input:checked ~ .checkmark { border-color: var(--cyan-accent); }
    .checkmark:after { content: ""; position: absolute; display: none; }
    .custom-radio input:checked ~ .checkmark:after { display: block; }
    .custom-radio .checkmark:after { top: 50%; left: 50%; transform: translate(-50%, -50%); width: 8px; height: 8px; border-radius: 50%; background: var(--cyan-accent); }
</style>

<div class="module-container">
    <div class="mb-4">
        <h2 style="font-weight: 700; font-size: 2.2rem; margin-bottom: 8px;">Seleccionar Cliente</h2>
        <p style="color: var(--text-muted); font-size: 1rem;">Identifique al cliente para iniciar el proceso de emisión o ajuste de límite de tarjeta de crédito.</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="background-color: rgba(255, 107, 107, 0.1); border: 1px solid #FF6B6B; color: #FF6B6B; border-radius: 8px; padding: 15px; margin-bottom: 24px;">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.SearchMessage != null)
    {
        <div class="alert alert-warning" style="background-color: rgba(255, 171, 0, 0.1); border: 1px solid #FFAB00; color: #FFAB00; border-radius: 8px; padding: 15px; margin-bottom: 24px;">
            @ViewBag.SearchMessage
        </div>
    }

    <div class="d-flex gap-4 mb-4">
        <!-- Tarjeta Búsqueda -->
        <div class="info-card" style="flex: 2;">
            <form asp-action="AssignCardStep1" method="get" class="d-flex gap-3 h-100 align-items-center">
                <div style="flex: 1; position: relative;">
                    <svg style="position: absolute; left: 15px; top: 12px; color: var(--text-muted);" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" name="searchCedula" value="@Model.SearchCedula" class="form-control" style="background-color: #080D17; border: 1px solid var(--border-color); color: white; padding: 10px 15px 10px 45px; border-radius: 8px; width: 100%;" placeholder="Buscar por cédula o pasaporte..." />
                </div>
                <a asp-action="AssignCardStep1" class="btn-outline" style="padding: 10px 20px;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:5px;"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg> Filtrar
                </a>
                <button type="submit" class="btn-next" style="padding: 10px 20px;">Buscar</button>
            </form>
        </div>

        <!-- Tarjeta Promedio Sistema -->
        <div class="info-card" style="flex: 1; background-color: #141C2B;">
            <div class="d-flex align-items-center justify-content-end gap-3 h-100">
                <div style="background-color: rgba(0, 229, 255, 0.1); padding: 10px; border-radius: 8px; color: var(--cyan-accent);">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                </div>
                <div style="text-align: right;">
                    <div style="color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px;">MONTO PROMEDIO DE DEUDA</div>
                    <div style="font-size: 1.5rem; font-weight: 700; color: white;">@Model.AverageSystemDebt.ToString("C") <span style="font-size: 1rem; color: var(--text-muted); font-weight: normal;">USD</span></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Clientes (Formulario) -->
    <form asp-action="AssignCardStep1" method="post">
        <div class="info-card">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th style="width: 50px;"></th>
                        <th>Cédula</th>
                        <th>Nombre y Apellido</th>
                        <th>Correo Electrónico</th>
                        <th style="text-align: right;">Monto Total de Deuda</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model.EligibleClients)
                    {
                        <tr>
                            <td>
                                <label class="custom-radio">
                                    <input type="radio" name="SelectedClientId" value="@client.Id">
                                    <span class="checkmark"></span>
                                </label>
                            </td>
                            <td>@client.Cedula</td>
                            <td style="font-weight: 600; color: white;">@client.FullName</td>
                            <td style="color: var(--text-muted);">@client.Email</td>
                            <td style="text-align: right;">
                                <span style="background-color: @(client.TotalDebt > 0 ? "rgba(255, 107, 107, 0.1)" : "transparent"); color: @(client.TotalDebt > 0 ? "#FF6B6B" : "var(--text-muted)"); padding: 4px 12px; border-radius: 12px; font-weight: @(client.TotalDebt > 0 ? "600" : "normal");">
                                    @client.TotalDebt.ToString("C")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top" style="border-color: var(--border-color) !important;">
                <div style="color: var(--text-muted); font-size: 0.9rem;">Mostrando 1 a @Model.EligibleClients.Count clientes</div>
                <div class="d-flex gap-3">
                    <a asp-action="CreditCardManagement" class="btn-outline">
                        &larr; Volver atrás
                    </a>
                    <button type="submit" class="btn-next">
                        Siguiente paso &rarr;
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>