@model Application.Models.ViewModels.Admin.EditCreditCardLimitViewModel
@{
    ViewData["Title"] = "Editar Límite de Tarjeta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .module-container { background-color: var(--bg-main); min-height: 100%; }
    .form-card { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 30px; max-width: 600px; margin-top: 30px; }
    
    .info-boxes { display: flex; gap: 15px; margin-bottom: 25px; }
    .info-box { background-color: #080D17; border: 1px solid var(--border-color); border-radius: 8px; padding: 15px; flex: 1; }
    
    .custom-label { color: white; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; display: block; }
    .custom-input { background-color: #080D17; border: 1px solid var(--border-color); color: white; padding: 12px 16px; border-radius: 8px; width: 100%; outline: none; font-size: 1.1rem; }
    .custom-input:focus { border-color: var(--cyan-accent); }
    
    .btn-outline { background-color: transparent; color: white; border: 1px solid var(--border-color); padding: 12px 24px; border-radius: 8px; font-weight: 600; text-decoration: none; }
    .btn-next { background-color: var(--cyan-accent); color: #000; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 600; cursor: pointer; }
</style>

<div class="module-container">
    <div>
        <a asp-action="CreditCardManagement" style="color: white; text-decoration: none; display: flex; align-items: center; gap: 8px; margin-bottom: 15px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg> Volver atrás
        </a>
        <h2 style="font-weight: 700; font-size: 2rem; margin-bottom: 4px;">Editar Límite de Tarjeta</h2>
        <p style="color: var(--text-muted); font-size: 1rem;">MasterCard Black @Model.MaskedNumber</p>
    </div>

    <div class="form-card">

        <form asp-action="EditCreditCardLimit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="MaskedNumber" />
            <input type="hidden" asp-for="CurrentDebt" />
            <input type="hidden" asp-for="CurrentLimit" />

            <div class="mb-2">
                <label class="custom-label" asp-for="NewLimit">Nuevo Límite de la tarjeta</label>
                <div style="position: relative;">
                    <span style="position: absolute; left: 15px; top: 13px; color: white; font-weight: 600; font-size: 1.1rem;">$</span>
                    <input asp-for="NewLimit" type="number" step="0.01" class="custom-input" style="padding-left: 35px; padding-right: 50px;" />
                    <span style="position: absolute; right: 15px; top: 15px; color: var(--text-muted); font-weight: 600; font-size: 0.9rem;">RD$</span>
                </div>
                <span asp-validation-for="NewLimit" class="text-danger" style="font-size: 0.85rem; display: block; margin-top: 5px;"></span>
            </div>
            
            <p style="color: var(--text-muted); font-size: 0.75rem; margin-bottom: 30px;">El aumento del límite está sujeto a análisis crediticio automatizado.</p>

            <div class="d-flex justify-content-end gap-3 border-top pt-4" style="border-color: var(--border-color) !important;">
                <a asp-action="CreditCardManagement" class="btn-outline">Volver atrás</a>
                <button type="submit" class="btn-next">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }