@model Application.Models.ViewModels.Admin.SavingsAccountDetailsViewModel
@{
    ViewData["Title"] = "Detalles de Cuenta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .module-container { background-color: var(--bg-main); min-height: 100%; }
    
    .summary-card { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 25px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center;}
    
    .table-container { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 25px; }
    .custom-table { width: 100%; color: white; border-collapse: separate; border-spacing: 0 10px; }
    .custom-table th { color: var(--text-muted); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; padding: 0 15px 10px 15px; border-bottom: 1px solid var(--border-color); }
    .custom-table td { padding: 15px; font-size: 0.9rem; vertical-align: middle; border-bottom: 1px solid rgba(255,255,255,0.03); }
    
    .badge-trans { padding: 4px 10px; border-radius: 6px; font-size: 0.7rem; font-weight: 700; display: inline-flex; align-items: center;}
    .badge-credito { color: #00E5FF; background-color: rgba(0, 229, 255, 0.1); }
    .badge-debito { color: #FF6B6B; background-color: rgba(255, 107, 107, 0.1); }
    
    .badge-status { padding: 4px 10px; border-radius: 20px; font-size: 0.7rem; font-weight: 700;}
    .badge-aprobada { border: 1px solid var(--cyan-accent); color: var(--cyan-accent); }
    .badge-rechazada { border: 1px solid var(--text-muted); color: var(--text-muted); }
</style>

<div class="module-container">
    <div class="mb-4">
        <a asp-action="SavingsAccountManagement" style="color: white; text-decoration: none; display: flex; align-items: center; gap: 8px; margin-bottom: 20px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg> Volver atrás
        </a>
        <h2 style="font-weight: 700; font-size: 2.2rem; color: white;">Transacciones de la Cuenta</h2>
    </div>

    <div class="summary-card">
        <div class="d-flex align-items-center gap-4">
            <div style="width: 60px; height: 60px; background-color: #141C2B; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--cyan-accent);">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
            </div>
            <div>
                <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px;">Cuenta @Model.AccountType</div>
                <div style="font-family: monospace; font-size: 1.4rem; color: white; font-weight: 600;">@Model.AccountNumber</div>
                <div style="font-size: 0.9rem; color: var(--text-muted); margin-top: 2px;">Titular: @Model.ClientName</div>
            </div>
        </div>
        <div style="text-align: right; border-left: 1px solid var(--border-color); padding-left: 30px;">
            <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px;">BALANCE DISPONIBLE</div>
            <div style="font-size: 2.2rem; color: var(--cyan-accent); font-weight: 700;">@Model.CurrentBalance.ToString("C")</div>
        </div>
    </div>

    <div class="table-container">
        <h5 style="color: white; font-weight: 700; margin-bottom: 20px;">Historial de Transacciones</h5>

        <table class="custom-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Monto</th>
                    <th>Origen</th>
                    <th>Beneficiario</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var trans in Model.Transactions)
                {
                    <tr>
                        <td style="color: var(--text-muted);">@trans.Date.ToString("dd MMM yyyy, HH:mm")</td>
                        <td>
                            <span class="badge-trans @(trans.Type == "CRÉDITO" ? "badge-credito" : "badge-debito")">
                                @if (trans.Type == "CRÉDITO") { <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg> }
                                else { <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px;"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg> }
                                @trans.Type
                            </span>
                        </td>
                        <td style="color: white; font-weight: 600;">@trans.Amount.ToString("C")</td>
                        <td style="color: white;">@trans.Origin</td>
                        <td style="color: white;">@trans.Beneficiary</td>
                        <td>
                            <span class="badge-status @(trans.Status == "APROBADA" ? "badge-aprobada" : "badge-rechazada")">@trans.Status</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>