@model Application.Models.ViewModels.Admin.CancelSavingsAccountViewModel
@{
    ViewData["Title"] = "Cancelar Cuenta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="display: flex; align-items: center; justify-content: center; height: 100%; background-color: var(--bg-main);">
    <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 40px; text-align: center; max-width: 500px;">
        <div style="width: 70px; height: 70px; background-color: rgba(255, 107, 107, 0.1); border: 2px solid #FF6B6B; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto; color: #FF6B6B;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
        </div>
        
        <h2 style="color: white; font-weight: 700; margin-bottom: 15px;">Cancelar Cuenta Secundaria</h2>
        <p style="color: var(--text-muted); font-size: 1.1rem; margin-bottom: 10px;">¿Está seguro que desea cancelar la cuenta <strong>@Model.AccountNumber</strong>?</p>
        
        @if (Model.CurrentBalance > 0)
        {
            <div style="background-color: rgba(0, 229, 255, 0.05); border: 1px solid rgba(0, 229, 255, 0.2); border-radius: 8px; padding: 15px; margin-top: 20px; text-align: left; display: flex; gap: 12px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--cyan-accent)" stroke-width="2" style="flex-shrink: 0;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                <div style="font-size: 0.85rem; color: var(--text-muted);">
                    Esta cuenta tiene un balance de <strong style="color: white;">@Model.CurrentBalance.ToString("C")</strong>. Al confirmar, este monto será transferido automáticamente a la cuenta principal del cliente.
                </div>
            </div>
        }

        <form asp-action="CancelSavingsAccountConfirmed" method="post" class="d-flex justify-content-center gap-3 mt-4">
            <input type="hidden" asp-for="Id" />
            <a asp-action="SavingsAccountManagement" style="background-color: transparent; color: white; border: 1px solid var(--border-color); padding: 10px 24px; border-radius: 8px; font-weight: 600; text-decoration: none;">Cancelar</a>
            <button type="submit" style="background-color: #FF6B6B; color: white; border: none; padding: 10px 24px; border-radius: 8px; font-weight: 600; cursor: pointer;">Aceptar</button>
        </form>
    </div>
</div>