@model Application.Models.ViewModels.Admin.LoanDetailsViewModel
@{
    ViewData["Title"] = "Detalles del Préstamo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .module-container { background-color: var(--bg-main); min-height: 100%; }
    
    .top-actions { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
    .btn-outline { background-color: transparent; color: white; border: 1px solid var(--border-color); padding: 10px 20px; border-radius: 8px; font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 8px; }
    .btn-cyan { background-color: var(--cyan-accent); color: #000; padding: 10px 20px; border-radius: 8px; font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 8px; }
    
    .summary-cards { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 20px; margin-bottom: 24px; }
    .card-panel { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; }
    
    .custom-table { width: 100%; color: white; border-collapse: separate; border-spacing: 0 10px; }
    .custom-table th { color: var(--text-muted); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; padding: 0 15px 10px 15px; border-bottom: 1px solid var(--border-color); }
    .custom-table td { padding: 15px; background-color: #080D17; font-size: 0.85rem; vertical-align: middle; }
    .custom-table tr td:first-child { border-top-left-radius: 8px; border-bottom-left-radius: 8px; color: var(--text-muted); font-weight: bold; }
    .custom-table tr td:last-child { border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
    
    .row-highlight td { background-color: rgba(0, 229, 255, 0.03); border-top: 1px solid rgba(0, 229, 255, 0.1); border-bottom: 1px solid rgba(0, 229, 255, 0.1); }
    .row-highlight td:first-child { border-left: 3px solid var(--cyan-accent); color: var(--cyan-accent); }
    
    .badge-pay { padding: 4px 10px; border-radius: 4px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; border: 1px solid; }
    .badge-pagada { border-color: transparent; color: #4A90E2; background-color: rgba(74, 144, 226, 0.15); }
    .badge-parcial { border-color: #4A90E2; color: #4A90E2; background-color: transparent; }
    .badge-pendiente { border-color: var(--text-muted); color: var(--text-muted); background-color: transparent; }
</style>

<div class="module-container">
    <div class="top-actions">
        <a asp-action="LoanManagement" class="btn-outline">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg> Volver atrás
        </a>
        <div class="d-flex gap-3">
            <button class="btn-outline">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg> Exportar PDF
            </button>
        </div>
    </div>

    <div class="summary-cards">
        <!-- Main Info -->
        <div class="card-panel position-relative">
            <span style="position: absolute; top: 20px; right: 20px; background-color: rgba(0, 229, 255, 0.1); color: var(--cyan-accent); font-size: 0.75rem; font-weight: 600; padding: 4px 10px; border-radius: 20px; display: flex; align-items: center; gap: 6px;"><span style="width:6px; height:6px; border-radius:50%; background-color:var(--cyan-accent);"></span> Activo</span>
            
            <div style="color: var(--text-muted); font-size: 0.75rem; font-weight: 600; letter-spacing: 1px; margin-bottom: 8px;">CAPITAL TOTAL</div>
            <div style="color: var(--cyan-accent); font-size: 2.2rem; font-weight: 700; margin-bottom: 5px;">@Model.ApprovedAmount.ToString("C")</div>
            <div style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 25px;">Préstamo #@Model.LoanNumber</div>
            
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 4px;">Cliente</div>
                    <div class="d-flex align-items-center gap-2">
                        <div style="width: 28px; height: 28px; border-radius: 50%; background-color: #1A2436; display: flex; justify-content: center; align-items: center; color: var(--text-muted);"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></div>
                        <span style="font-weight: 600; color: white;">@Model.ClientName</span>
                    </div>
                </div>
                <div style="width: 40%;">
                    <div class="d-flex justify-content-between" style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 4px;"><span>Progreso de Pago</span><span style="color: var(--cyan-accent);">@Model.PaymentProgress%</span></div>
                    <div style="height: 4px; background-color: #1F2A3D; border-radius: 2px;"><div style="height: 100%; width: @Model.PaymentProgress%; background-color: var(--cyan-accent); border-radius: 2px;"></div></div>
                </div>
            </div>
        </div>

        <!-- Params -->
        <div class="card-panel d-flex flex-column justify-content-center gap-4">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex gap-2 align-items-center" style="color: var(--text-muted); font-size: 0.8rem;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="5" x2="5" y2="19"></line><circle cx="6.5" cy="6.5" r="2.5"></circle><circle cx="17.5" cy="17.5" r="2.5"></circle></svg> Tasa de Interés</div>
                <div style="text-align: right;"><div style="color: white; font-weight: 700; font-size: 1.1rem;">@Model.InterestRate.ToString("0.0")%</div><div style="color: var(--text-muted); font-size: 0.7rem;">Anual</div></div>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex gap-2 align-items-center" style="color: var(--text-muted); font-size: 0.8rem;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line></svg> Plazo Total</div>
                <div style="color: white; font-weight: 700; font-size: 1.1rem;">@Model.TermInMonths Meses</div>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex gap-2 align-items-center" style="color: var(--text-muted); font-size: 0.8rem;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="10" x2="21" y2="10"></line></svg> Fecha Inicio</div>
                <div style="color: white; font-weight: 700; font-size: 1rem;">@Model.StartDate.ToString("dd MMM, yyyy")</div>
            </div>
        </div>

        <!-- Balance -->
        <div class="card-panel d-flex flex-column justify-content-center gap-4">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex gap-2 align-items-center" style="color: var(--text-muted); font-size: 0.8rem;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect><line x1="6" y1="8" x2="6" y2="8"></line><line x1="10" y1="8" x2="18" y2="8"></line></svg> Saldo Pendiente</div>
                <div style="color: white; font-weight: 700; font-size: 1.1rem;">@Model.PendingBalance.ToString("C")</div>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex gap-2 align-items-center" style="color: var(--text-muted); font-size: 0.8rem;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg> Cuota Mensual</div>
                <div style="color: white; font-weight: 700; font-size: 1.1rem;">@Model.MonthlyQuote.ToString("C")</div>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex gap-2 align-items-center" style="color: var(--text-muted); font-size: 0.8rem;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg> Próximo Vencimiento</div>
                <div style="color: #FF6B6B; font-weight: 700; font-size: 1rem; text-align: right; width: 60px; line-height: 1.2;">@Model.NextDueDate.ToString("dd MMM, yyyy")</div>
            </div>
        </div>
    </div>

    <!-- Amortization Table -->
    <div class="card-panel">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 style="color: white; font-weight: 600; display: flex; align-items: center; gap: 10px;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--cyan-accent)" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg> Tabla de Amortización</h5>
            <input type="text" class="form-control" style="background-color: #080D17; border: 1px solid var(--border-color); color: white; border-radius: 8px; width: 250px;" placeholder="Buscar cuota..." />
        </div>

        <table class="custom-table">
            <thead>
                <tr>
                    <th>N°</th>
                    <th>Fecha Venc.</th>
                    <th>Valor Cuota</th>
                    <th>Interés</th>
                    <th>Capital</th>
                    <th>Saldo Pend.</th>
                    <th>Estado</th>
                    <th>Atraso</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.AmortizationTable)
                {
                    <tr class="@(row.PaymentStatus == "Pendiente" && row.InstallmentNumber == 10 ? "row-highlight" : "")">
                        <td>@row.InstallmentNumber</td>
                        <td>
                            <div style="color: white; font-weight: 600;">@row.DueDate.ToString("dd")</div>
                            <div style="color: var(--text-muted); font-size: 0.75rem;">@row.DueDate.ToString("MMM, yyyy")</div>
                        </td>
                        <td style="@(row.PaymentStatus == "Pendiente" && row.InstallmentNumber == 10 ? "color: var(--cyan-accent); font-weight: 700;" : "color: white;")">@row.InstallmentValue.ToString("C")</td>
                        <td>@row.InterestAmount.ToString("C")</td>
                        <td>@row.CapitalAmount.ToString("C")</td>
                        <td>@row.PendingBalance.ToString("C")</td>
                        <td>
                            @{
                                string badgeClass = row.PaymentStatus switch {
                                    "Pagada" => "badge-pagada",
                                    "Parcial" => "badge-parcial",
                                    _ => "badge-pendiente"
                                };
                            }
                            <span class="badge-pay @badgeClass">@row.PaymentStatus</span>
                        </td>
                        <td>
                            @if (row.IsOverdue) { <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF6B6B" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg> }
                            else { <span>-</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        
        <div style="text-align: right; color: var(--text-muted); font-size: 0.8rem; margin-top: 15px;">Mostrando 1-@Model.AmortizationTable.Count de @Model.TermInMonths cuotas</div>
    </div>
</div>