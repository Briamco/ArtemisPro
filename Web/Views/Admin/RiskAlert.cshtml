@model Application.Models.ViewModels.Admin.RiskAlertViewModel
@{
    ViewData["Title"] = "Alerta de Riesgo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .module-container { background-color: var(--bg-main); min-height: 100%; display: flex; align-items: center; justify-content: center; }
    .alert-card { background-color: #0A111F; border: 1px solid var(--border-color); border-radius: 16px; padding: 40px; max-width: 750px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    
    .warning-icon-wrapper { width: 70px; height: 70px; background-color: rgba(255, 107, 107, 0.1); border: 2px solid #FF6B6B; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto; color: #FF6B6B; }
    .alert-title { color: #FF9E9E; font-size: 2.2rem; font-weight: 700; margin-bottom: 10px; }
    .alert-subtitle { color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; margin-bottom: 30px; padding: 0 40px; }
    
    .data-cards-container { display: flex; gap: 15px; margin-bottom: 25px; }
    .data-card { background-color: #050810; border: 1px solid var(--border-color); border-radius: 12px; padding: 20px; flex: 1; text-align: left; }
    .data-card-title { color: var(--text-muted); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 15px; display: flex; align-items: center; gap: 8px; }
    .data-card-value { color: white; font-size: 1.6rem; font-weight: 700; margin-bottom: 15px; }
    
    .progress-bar { height: 4px; background-color: #1F2A3D; border-radius: 2px; width: 100%; margin-bottom: 8px; overflow: hidden;}
    .progress-fill-safe { height: 100%; background-color: #4A90E2; width: 40%; }
    .progress-fill-danger { height: 100%; background: linear-gradient(90deg, #FF6B6B, #FF4545); width: 100%; }
    .progress-fill-sys { height: 100%; background-color: #00E5FF; width: 70%; }
    
    .card-footer-text { font-size: 0.7rem; color: var(--text-muted); }
    
    .recommendation-box { background-color: rgba(0, 229, 255, 0.05); border: 1px solid rgba(0, 229, 255, 0.2); border-radius: 8px; padding: 15px; display: flex; gap: 12px; text-align: left; margin-bottom: 30px; }
    
    .btn-cancel { background-color: transparent; color: #FF9E9E; border: 1px solid #FF9E9E; padding: 12px 24px; border-radius: 8px; font-weight: 600; text-decoration: none; cursor: pointer; }
    .btn-confirm { background-color: var(--cyan-accent); color: #000; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px; }
</style>

<div class="module-container">
    <div class="alert-card">
        <div class="warning-icon-wrapper">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        </div>
        
        <h2 class="alert-title">Alerta de Alto Riesgo</h2>
        <p class="alert-subtitle">@Model.WarningMessage</p>
        
        <div class="data-cards-container">
            <div class="data-card">
                <div class="data-card-title">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect><line x1="6" y1="8" x2="6" y2="8"></line><line x1="10" y1="8" x2="18" y2="8"></line></svg>
                    DEUDA ACTUAL
                </div>
                <div class="data-card-value">RD$ @Model.CurrentDebt.ToString("N2")</div>
                <div class="progress-bar"><div class="progress-fill-safe"></div></div>
                <div class="card-footer-text">Nivel Seguro</div>
            </div>
            
            <div class="data-card" style="background-color: rgba(255, 107, 107, 0.05); border-color: rgba(255, 107, 107, 0.2);">
                <div class="data-card-title" style="color: #FF9E9E;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                    PROYECTADA
                </div>
                <div class="data-card-value" style="color: #FF9E9E;">RD$ @Model.ProjectedDebt.ToString("N2")</div>
                <div class="progress-bar"><div class="progress-fill-danger"></div></div>
                <div class="card-footer-text" style="color: #FF9E9E;">Excede Límite</div>
            </div>
            

            <div class="data-card">
                <div class="data-card-title">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line></svg>
                    PROMEDIO SYS
                </div>
                <div class="data-card-value" style="color: var(--cyan-accent);">RD$ @Model.SystemAverage.ToString("N2")</div>
                <div class="progress-bar"><div class="progress-fill-sys"></div></div>
                <div class="card-footer-text">Umbral Base</div>
            </div>
        </div>
        
        <div class="recommendation-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--cyan-accent)" stroke-width="2" style="flex-shrink: 0;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
            <div>
                <strong style="color: white; font-size: 0.85rem; display: block; margin-bottom: 5px;">Recomendación del Sistema</strong>
                <span style="color: var(--text-muted); font-size: 0.8rem;">Revisar el historial crediticio extendido antes de proceder. La asignación de este préstamo requiere autorización de Nivel 2.</span>
            </div>
        </div>
        
        <form asp-action="ConfirmRiskLoan" method="post" class="d-flex justify-content-center gap-3">
            <input type="hidden" asp-for="ClientId" />
            <input type="hidden" asp-for="Amount" />
            <input type="hidden" asp-for="InterestRate" />
            <input type="hidden" asp-for="TermInMonths" />
            
            <a asp-action="LoanManagement" class="btn-cancel"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 5px;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg> CANCELAR</a>
            <button type="submit" class="btn-confirm"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> CONFIRMAR ASIGNACIÓN</button>
        </form>
    </div>
</div>