@model Application.Models.ViewModels.Admin.EditUserViewModel
@{
    ViewData["Title"] = "Editar Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .form-container {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 40px;
        margin-top: 30px;
        max-width: 900px;
    }
    .custom-label {
        color: white;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
    }
    .custom-label span { color: #FF6B6B; }
    
    .custom-input {
        background-color: #080D17;
        border: 1px solid var(--border-color);
        color: white;
        padding: 12px 16px;
        border-radius: 8px;
        width: 100%;
        outline: none;
        transition: border-color 0.3s ease;
    }
    .custom-input:focus { border-color: var(--cyan-accent); }
    .custom-input::placeholder { color: #4A5568; }
    
    .input-readonly {
        background-color: #1A2436;
        color: var(--text-muted);
        cursor: not-allowed;
    }

    .btn-cancel {
        background-color: transparent;
        color: white;
        border: 1px solid var(--border-color);
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
    }
    .btn-save {
        background-color: var(--cyan-accent);
        color: #000;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }
</style>

<div>
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h2 style="font-weight: 700; font-size: 2.2rem; margin-bottom: 8px;">Editar Usuario</h2>
            <p style="color: var(--text-muted); font-size: 1rem;">Modifica los datos del usuario seleccionado.</p>
        </div>
        <a asp-action="UserManagement" style="color: var(--text-muted);"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></a>
    </div>

    <div class="form-container">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" style="background-color: rgba(255, 107, 107, 0.1); border: 1px solid #FF6B6B; color: #FF6B6B; border-radius: 8px; padding: 15px; margin-bottom: 24px;">
                @TempData["ErrorMessage"]
            </div>
        }
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 0.85rem;"></div>

        <form asp-action="EditUser" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Role" /> 

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="custom-label" asp-for="FirstName">Nombre <span>*</span></label>
                    <input asp-for="FirstName" class="custom-input" />
                    <span asp-validation-for="FirstName" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>
                <div class="col-md-6">
                    <label class="custom-label" asp-for="LastName">Apellido <span>*</span></label>
                    <input asp-for="LastName" class="custom-input" />
                    <span asp-validation-for="LastName" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <div class="col-md-6">
                    <label class="custom-label" asp-for="Identification">Cédula <span>*</span></label>
                    <input asp-for="Identification" class="custom-input" />
                    <span asp-validation-for="Identification" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>
                <div class="col-md-6">
                    <label class="custom-label" asp-for="Email">Correo electrónico <span>*</span></label>
                    <input asp-for="Email" class="custom-input" />
                    <span asp-validation-for="Email" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <div class="col-md-6">
                    <label class="custom-label" asp-for="Username">Nombre de usuario <span>*</span></label>
                    <div style="position: relative;">
                        <svg style="position: absolute; left: 15px; top: 12px; color: #4A5568;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        <input asp-for="Username" class="custom-input" style="padding-left: 45px;" />
                    </div>
                    <span asp-validation-for="Username" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>
                
                <div class="col-md-6">
                    <label class="custom-label">Tipo de usuario</label>
                    <input type="text" value="@Model.Role" class="custom-input input-readonly" readonly />
                    <small style="color: var(--text-muted); font-size: 0.75rem;">El rol no puede modificarse tras la creación.</small>
                </div>

                <div class="col-12 mt-4 mb-2">
                    <h5 style="color: var(--cyan-accent); font-size: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">Seguridad (Opcional)</h5>
                </div>

                <div class="col-md-6">
                    <label class="custom-label" asp-for="NewPassword">Nueva contraseña</label>
                    <div style="position: relative;">
                        <svg style="position: absolute; left: 15px; top: 12px; color: #4A5568;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        <input asp-for="NewPassword" class="custom-input" style="padding-left: 45px;" placeholder="Dejar vacío para no cambiar" />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>
                <div class="col-md-6">
                    <label class="custom-label" asp-for="ConfirmNewPassword">Confirmar nueva contraseña</label>
                    <div style="position: relative;">
                        <svg style="position: absolute; left: 15px; top: 12px; color: #4A5568;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        <input asp-for="ConfirmNewPassword" class="custom-input" style="padding-left: 45px;" placeholder="Reescriba la contraseña" />
                    </div>
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                @if (Model.Role == "Cliente")
                {
                    <div class="col-12 mt-4 mb-2">
                        <h5 style="color: var(--cyan-accent); font-size: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">Fondos Administrativos</h5>
                    </div>
                    <div class="col-md-6">
                        <label class="custom-label" asp-for="AdditionalAmount">Monto adicional (RD$)</label>
                        <input asp-for="AdditionalAmount" type="number" step="0.01" class="custom-input" placeholder="0.00" />
                        <span asp-validation-for="AdditionalAmount" class="text-danger" style="font-size: 0.8rem;"></span>
                        <small style="color: var(--text-muted); font-size: 0.75rem;">Se sumará al balance actual de la cuenta principal.</small>
                    </div>
                }

            </div>

            <div class="d-flex justify-content-end gap-3 mt-5">
                <a asp-action="UserManagement" class="btn-cancel">Cancelar</a>
                <button type="submit" class="btn-save">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}