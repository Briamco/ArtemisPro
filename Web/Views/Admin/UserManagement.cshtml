@model Application.Models.ViewModels.Admin.UserListViewModel
@{
    ViewData["Title"] = "Gestión de Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .module-container {
        background-color: var(--bg-main);
        min-height: 100%;
    }
    .table-container {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 24px;
    }
    .filter-bar {
        background-color: #141C2B;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 15px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }
    .custom-select {
        background-color: #0B101E;
        color: white;
        border: 1px solid var(--border-color);
        padding: 8px 16px;
        border-radius: 6px;
        outline: none;
    }
    .custom-table {
        width: 100%;
        color: white;
        border-collapse: separate;
        border-spacing: 0 15px;
    }
    .custom-table th {
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 0 15px 10px 15px;
        border-bottom: 1px solid var(--border-color);
    }
    .custom-table td {
        padding: 15px;
        background-color: #0B101E;
        font-size: 0.9rem;
    }
    .custom-table tr td:first-child { border-top-left-radius: 8px; border-bottom-left-radius: 8px; font-weight: 600; color: var(--cyan-accent); }
    .custom-table tr td:last-child { border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
    
    .badge-role {
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .badge-admin { background-color: rgba(0, 229, 255, 0.1); color: var(--cyan-accent); border: 1px solid rgba(0, 229, 255, 0.2); }
    .badge-cajero { background-color: transparent; color: #4A90E2; border: 1px solid #4A90E2; }
    .badge-cliente { background-color: transparent; color: var(--text-muted); border: 1px solid var(--text-muted); }
    
    .status-dot {
        height: 8px; width: 8px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 6px;
    }
    .status-active { background-color: #00E589; }
    .status-inactive { background-color: #FF6B6B; }

    .btn-create {
        background-color: var(--cyan-accent);
        color: #000;
        font-weight: 600;
        padding: 10px 24px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .btn-create:hover { background-color: #00B8CC; color: #000; }
</style>

<div class="module-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="background-color: rgba(0, 229, 255, 0.1); border: 1px solid var(--cyan-accent); color: var(--cyan-accent); border-radius: 8px; padding: 15px; margin-bottom: 24px;">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="background-color: rgba(255, 107, 107, 0.1); border: 1px solid #FF6B6B; color: #FF6B6B; border-radius: 8px; padding: 15px; margin-bottom: 24px;">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 style="font-weight: 700; font-size: 2.2rem; margin-bottom: 8px;">Gestión de Usuarios</h2>
            <p style="color: var(--text-muted); font-size: 1rem;">Administra los accesos y roles del sistema.</p>
        </div>
        <a asp-action="CreateUser" class="btn-create">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Crear usuario
        </a>
    </div>

    <div class="filter-bar">
       <form asp-action="UserManagement" method="get" id="filterForm" class="d-flex align-items-center gap-3">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
            <span style="color: var(--text-muted); font-weight: 600;">Filtrar por rol:</span>
            <select class="custom-select" name="roleFilter" onchange="document.getElementById('filterForm').submit();">
                <option value="Todos" selected="@(Model.CurrentFilter == "Todos")">Todos</option>
                <option value="Administrador" selected="@(Model.CurrentFilter == "Administrador")">Administrador</option>
                <option value="Cajero" selected="@(Model.CurrentFilter == "Cajero")">Cajero</option>
                <option value="Cliente" selected="@(Model.CurrentFilter == "Cliente")">Cliente</option>
            </select>
        </form>
        <div style="color: var(--text-muted); font-size: 0.85rem;">
            @if (Model.TotalRecords > 0)
            {
                var startRecord = ((Model.CurrentPage - 1) * 20) + 1;
                var endRecord = Math.Min(Model.CurrentPage * 20, Model.TotalRecords);
                <span>Mostrando @startRecord-@endRecord de @Model.TotalRecords registros</span>
            }
            else
            {
                <span>No se encontraron usuarios</span>
            }
        </div>
    </div>

    <div class="table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Nombre de Usuario</th>
                    <th>Cédula</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Correo Electrónico</th>
                    <th>Tipo de Usuario</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Users.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center" style="color: var(--text-muted); padding: 30px;">
                            No hay usuarios registrados para este filtro.
                        </td>
                    </tr>
                }
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Username</td>
                        <td>@user.Identification</td>
                        <td>@user.FirstName</td>
                        <td>@user.LastName</td>
                        <td>@user.Email</td>
                        <td>
                            @if(user.Role == "Administrador") { <span class="badge-role badge-admin">Administrador</span> }
                            else if(user.Role == "Cajero") { <span class="badge-role badge-cajero">Cajero</span> }
                            else { <span class="badge-role badge-cliente">Cliente</span> }
                        </td>
                        <td>
                            <span class="status-dot @(user.IsActive ? "status-active" : "status-inactive")"></span>
                            @(user.IsActive ? "Activo" : "Inactivo")
                        </td>
                        <td>
                            <!-- Botón de Editar -->
                            <a asp-action="EditUser" asp-route-id="@user.Id" style="color: var(--cyan-accent); margin-right: 10px;" title="Editar">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                            </a>

                            @if (user.IsActive)
                            {
                                <form asp-action="InactivateUser" asp-route-id="@user.Id" method="post" style="display:inline;" onsubmit="return confirm('¿Está seguro que desea inactivar este usuario?');">
                                    <button type="submit" style="background: none; border: none; padding: 0; color: #FF6B6B; cursor: pointer;" title="Inactivar">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="ActivateUser" asp-route-id="@user.Id" method="post" style="display:inline;" onsubmit="return confirm('¿Está seguro que desea activar este usuario?');">
                                    <button type="submit" style="background: none; border: none; padding: 0; color: #00E589; cursor: pointer;" title="Activar">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        
        <!-- Paginación dinámica funcional -->
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center mt-4" style="color: var(--text-muted); font-size: 0.9rem;">
                @if (Model.CurrentPage > 1)
                {
                    <a asp-action="UserManagement" asp-route-roleFilter="@Model.CurrentFilter" asp-route-page="@(Model.CurrentPage - 1)" style="color: var(--text-muted); text-decoration: none;">&lt; Anterior</a>
                }
                else
                {
                    <span style="color: #4A5568; cursor: not-allowed;">&lt; Anterior</span>
                }

                <div class="d-flex gap-2">
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        if (p == Model.CurrentPage)
                        {
                            <span style="background-color: rgba(0, 229, 255, 0.1); color: var(--cyan-accent); padding: 5px 12px; border-radius: 4px; font-weight: 600;">@p</span>
                        }
                        else
                        {
                            <a asp-action="UserManagement" asp-route-roleFilter="@Model.CurrentFilter" asp-route-page="@p" style="color: var(--text-muted); text-decoration: none; padding: 5px 12px;">@p</a>
                        }
                    }
                </div>

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a asp-action="UserManagement" asp-route-roleFilter="@Model.CurrentFilter" asp-route-page="@(Model.CurrentPage + 1)" style="color: var(--text-muted); text-decoration: none;">Siguiente &gt;</a>
                }
                else
                {
                    <span style="color: #4A5568; cursor: not-allowed;">Siguiente &gt;</span>
                }
            </div>
        }
    </div>
</div>