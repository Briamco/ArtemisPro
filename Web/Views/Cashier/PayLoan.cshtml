@model Application.Models.ViewModels.Cashier.PayLoanViewModel
@{ 
    ViewData["Title"] = "Pago de Préstamo"; 
    Layout = "~/Views/Shared/_LayoutCashier.cshtml"; 
}

<style>
    .form-card { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 30px; max-width: 600px; margin-top: 20px;}
    .custom-label { color: white; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; display: block; }
    .custom-input { background-color: #080D17; border: 1px solid var(--border-color); color: white; padding: 12px 16px; border-radius: 8px; width: 100%; outline: none; font-size: 1.1rem; font-family: monospace; letter-spacing: 2px;}
    .custom-input:focus { border-color: var(--cyan-accent); }
    .btn-next { background-color: var(--cyan-accent); color: #000; border: none; padding: 12px 30px; border-radius: 8px; font-weight: 600; cursor: pointer; width: 100%; margin-top: 20px;}
    .validation-summary-errors { background-color: rgba(255, 107, 107, 0.1); border: 1px solid #FF6B6B; color: #FF6B6B; border-radius: 8px; padding: 15px; margin-bottom: 20px; font-size: 0.85rem; list-style: none; }
</style>

<div>
    <h2 style="font-weight: 700; font-size: 2.2rem; margin-bottom: 5px;">Pago a Préstamo</h2>
    <p style="color: var(--text-muted);">Abonar a las cuotas de un préstamo activo desde una cuenta de ahorros.</p>

    <div class="form-card">
        @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="validation-summary-errors"></div> }
        
        <form asp-action="PayLoan" method="post">
            <div class="mb-4">
                <label class="custom-label" asp-for="SourceAccountNumber">Número de cuenta origen</label>
                <input asp-for="SourceAccountNumber" class="custom-input" placeholder="Ej. 111222333" maxlength="9" autocomplete="off" />
                <span asp-validation-for="SourceAccountNumber" class="text-danger" style="font-size: 0.85rem; margin-top: 5px; display: block;"></span>
            </div>

            <div class="mb-4">
                <label class="custom-label" asp-for="LoanNumber">Número del préstamo (9 dígitos)</label>
                <input asp-for="LoanNumber" class="custom-input" placeholder="Ej. 123456789" maxlength="9" autocomplete="off" />
                <span asp-validation-for="LoanNumber" class="text-danger" style="font-size: 0.85rem; margin-top: 5px; display: block;"></span>
            </div>

            <div class="mb-2">
                <label class="custom-label" asp-for="Amount">Monto a pagar (RD$)</label>
                <input asp-for="Amount" type="number" step="0.01" class="custom-input" placeholder="0.00" style="font-family: inherit; letter-spacing: normal;" />
                <span asp-validation-for="Amount" class="text-danger" style="font-size: 0.85rem; margin-top: 5px; display: block;"></span>
            </div>

            <button type="submit" class="btn-next">Realizar pago</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}