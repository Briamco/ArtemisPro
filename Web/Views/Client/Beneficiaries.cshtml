@model Application.Models.ViewModels.Client.BeneficiaryListViewModel
@{
    ViewData["Title"] = "Mis Beneficiarios";
    Layout = "~/Views/Shared/_LayoutClient.cshtml";
}

<style>
    .module-container { background-color: var(--bg-main); min-height: 100%; }
    .table-container { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; }
    
    .custom-table { width: 100%; color: white; border-collapse: separate; border-spacing: 0 10px; }
    .custom-table th { color: var(--text-muted); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; padding: 0 15px 10px 15px; border-bottom: 1px solid var(--border-color); }
    .custom-table td { padding: 15px; font-size: 0.9rem; vertical-align: middle; background-color: #0B101E; border-bottom: none; }
    .custom-table tr td:first-child { border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
    .custom-table tr td:last-child { border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
    
    .btn-create { background-color: var(--cyan-accent); color: #000; font-weight: 600; padding: 10px 24px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
</style>

<div class="module-container">
    @if (TempData["SuccessMessage"] != null) { 
        <div class="alert alert-success" style="background-color: rgba(0, 229, 255, 0.1); border: 1px solid var(--cyan-accent); color: var(--cyan-accent); border-radius: 8px; padding: 15px; margin-bottom: 24px;">
            @TempData["SuccessMessage"]
        </div> 
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 style="font-weight: 700; font-size: 2.2rem; margin-bottom: 8px;">Mis Beneficiarios</h2>
            <p style="color: var(--text-muted); font-size: 1rem;">Administra las cuentas frecuentes para tus transferencias.</p>
        </div>
        <a asp-action="AddBeneficiary" class="btn-create">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Agregar beneficiario
        </a>
    </div>

    <div class="table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Número de cuenta</th>
                    <th style="text-align: right;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ben in Model.Beneficiaries)
                {
                    <tr>
                        <td style="color: white; font-weight: 600;">
                            <div class="d-flex align-items-center gap-2">
                                <div style="width: 32px; height: 32px; border-radius: 50%; background-color: rgba(0, 229, 255, 0.1); color: var(--cyan-accent); display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.8rem;">
                                    @ben.FirstName.Substring(0,1)
                                </div>
                                @ben.FirstName
                            </div>
                        </td>
                        <td style="color: white; font-weight: 600;">@ben.LastName</td>
                        <td style="font-family: monospace; font-size: 1rem; color: var(--text-muted);">@ben.AccountNumber</td>
                        <td style="text-align: right;">
                            <a asp-action="DeleteBeneficiary" asp-route-id="@ben.Id" style="color: #FF6B6B; display: inline-flex; align-items: center; gap: 5px; text-decoration: none; font-size: 0.85rem; font-weight: 600; padding: 6px 12px; border-radius: 6px; border: 1px solid transparent; transition: 0.2s;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg> Eliminar
                            </a>
                        </td>
                    </tr>
                }
                @if(!Model.Beneficiaries.Any())
                {
                    <tr>
                        <td colspan="4" style="text-align: center; color: var(--text-muted); padding: 40px 0;">No tienes beneficiarios registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>