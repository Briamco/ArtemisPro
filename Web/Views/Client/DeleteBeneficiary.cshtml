@model Application.Models.ViewModels.Client.DeleteBeneficiaryViewModel
@{
    ViewData["Title"] = "Eliminar Beneficiario";
    Layout = "~/Views/Shared/_LayoutClient.cshtml";
}

<div style="display: flex; align-items: center; justify-content: center; height: 100%; background-color: var(--bg-main);">
    <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 40px; text-align: center; max-width: 500px; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
        <div style="width: 70px; height: 70px; background-color: rgba(255, 107, 107, 0.1); border: 2px solid #FF6B6B; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto; color: #FF6B6B;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
        </div>
        
        <h2 style="color: white; font-weight: 700; margin-bottom: 15px;">Eliminar Beneficiario</h2>
        <p style="color: var(--text-muted); font-size: 1.1rem; margin-bottom: 25px;">¿Está seguro que desea eliminar este beneficiario?</p>
        
        <div style="background-color: #080D17; border: 1px solid var(--border-color); border-radius: 8px; padding: 15px; margin-bottom: 30px; text-align: left;">
            <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; margin-bottom: 4px;">Cuenta</div>
            <div style="font-family: monospace; font-size: 1.2rem; color: white; font-weight: 600; margin-bottom: 10px;">@Model.AccountNumber</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; margin-bottom: 4px;">Titular</div>
            <div style="color: white; font-weight: 500;">@Model.FirstName @Model.LastName</div>
        </div>

        <form asp-action="DeleteBeneficiaryConfirmed" method="post" class="d-flex justify-content-center gap-3">
            <input type="hidden" asp-for="Id" />
            <a asp-action="Beneficiaries" style="flex: 1; background-color: transparent; color: white; border: 1px solid var(--border-color); padding: 12px 24px; border-radius: 8px; font-weight: 600; text-decoration: none;">Cancelar</a>
            <button type="submit" style="flex: 1; background-color: #FF6B6B; color: white; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 600; cursor: pointer;">Aceptar</button>
        </form>
    </div>
</div>