@model Application.Models.ViewModels.Client.ClientLoanDetailsViewModel
@{
    ViewData["Title"] = "Detalles del Préstamo";
    Layout = "~/Views/Shared/_LayoutClient.cshtml";
}

<style>
    .module-container { background-color: var(--bg-main); min-height: 100%; }
    
    .summary-card { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 25px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center;}
    
    .table-container { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 25px; }
    .custom-table { width: 100%; color: white; border-collapse: separate; border-spacing: 0 10px; }
    .custom-table th { color: var(--text-muted); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; padding: 0 15px 10px 15px; border-bottom: 1px solid var(--border-color); }
    .custom-table td { padding: 15px; font-size: 0.9rem; vertical-align: middle; border-bottom: 1px solid rgba(255,255,255,0.03); }
    
    .badge-pay { padding: 4px 10px; border-radius: 4px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; border: 1px solid; }
    .badge-pagada { border-color: transparent; color: #4A90E2; background-color: rgba(74, 144, 226, 0.15); }
    .badge-parcial { border-color: #4A90E2; color: #4A90E2; background-color: transparent; }
    .badge-pendiente { border-color: var(--text-muted); color: var(--text-muted); background-color: transparent; }
</style>

<div class="module-container">
    <div class="mb-4">
        <a asp-action="Index" style="color: white; text-decoration: none; display: flex; align-items: center; gap: 8px; margin-bottom: 20px; font-weight: 500;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg> Volver atrás
        </a>
        <h2 style="font-weight: 700; font-size: 2.2rem; color: white; margin-bottom: 5px;">Tabla de Amortización</h2>
    </div>

    <div class="summary-card">
        <div class="d-flex align-items-center gap-4">
            <div style="width: 60px; height: 60px; background-color: rgba(74, 144, 226, 0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #4A90E2;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            </div>
            <div>
                <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px;">NÚMERO DE PRÉSTAMO</div>
                <div style="font-family: monospace; font-size: 1.4rem; color: white; font-weight: 600;">@Model.LoanNumber</div>
            </div>
        </div>
        <div style="text-align: right; border-left: 1px solid var(--border-color); padding-left: 30px;">
            <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px;">MONTO PENDIENTE</div>
            <div style="font-size: 2.2rem; color: white; font-weight: 700;">@Model.PendingAmount.ToString("C")</div>
        </div>
    </div>

    <div class="table-container">
        <h5 style="color: white; font-weight: 700; margin-bottom: 20px;">Desglose de Cuotas</h5>
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Fecha de pago</th>
                    <th>Valor de la cuota</th>
                    <th>Estado de pago</th>
                    <th>Atraso</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.AmortizationTable)
                {
                    <tr>
                        <td style="color: white; font-weight: 500;">@row.DueDate.ToString("dd MMM yyyy")</td>
                        <td style="color: white; font-weight: 600;">@row.InstallmentValue.ToString("C")</td>
                        <td>
                            @{
                                string badgeClass = row.Status switch {
                                    "Pagada" => "badge-pagada",
                                    "Parcial" => "badge-parcial",
                                    _ => "badge-pendiente"
                                };
                            }
                            <span class="badge-pay @badgeClass">@row.Status</span>
                        </td>
                        <td>
                            @if (row.IsOverdue) { 
                                <span style="color: #FF6B6B; display: flex; align-items: center; gap: 5px; font-weight: 600; font-size: 0.8rem;">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg> Atrasada
                                </span> 
                            }
                            else { <span style="color: var(--text-muted);">-</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>