@model Application.Models.ViewModels.Client.AddBeneficiaryViewModel
@{
    ViewData["Title"] = "Agregar Beneficiario";
    Layout = "~/Views/Shared/_LayoutClient.cshtml";
}

<style>
    .module-container { background-color: var(--bg-main); min-height: 100%; display: flex; align-items: center; justify-content: center; }
    .form-card { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 40px; width: 100%; max-width: 550px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); }
    
    .custom-label { color: white; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; display: block; }
    .custom-input { background-color: #080D17; border: 1px solid var(--border-color); color: white; padding: 12px 16px; border-radius: 8px; width: 100%; outline: none; font-size: 1.1rem; font-family: monospace; letter-spacing: 2px; }
    .custom-input:focus { border-color: var(--cyan-accent); }
    
    .btn-outline { background-color: transparent; color: white; border: 1px solid var(--border-color); padding: 12px 24px; border-radius: 8px; font-weight: 600; text-decoration: none; display: inline-block; text-align: center; }
    .btn-next { background-color: var(--cyan-accent); color: #000; border: none; padding: 12px 30px; border-radius: 8px; font-weight: 600; cursor: pointer; }
    
    .validation-summary-errors { background-color: rgba(255, 107, 107, 0.1); border: 1px solid #FF6B6B; color: #FF6B6B; border-radius: 8px; padding: 15px; margin-bottom: 20px; font-size: 0.85rem; list-style: none; }
    .validation-summary-errors ul { margin: 0; padding-left: 20px; }
</style>

<div class="module-container">
    <div class="form-card">
        <div style="width: 50px; height: 50px; background-color: rgba(0, 229, 255, 0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--cyan-accent); margin-bottom: 20px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
        </div>
        
        <h2 style="font-weight: 700; font-size: 1.8rem; margin-bottom: 8px; color: white;">Agregar beneficiario</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 30px;">Ingrese el número de cuenta que desea registrar como frecuente.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="validation-summary-errors"></div>
        }

        <form asp-action="AddBeneficiary" method="post">
            <div class="mb-4">
                <label class="custom-label" asp-for="AccountNumber">Número de cuenta</label>
                <input asp-for="AccountNumber" type="text" maxlength="9" class="custom-input" placeholder="Ej: 111222333" autocomplete="off" />
            </div>

            <div class="d-flex gap-3 mt-4 pt-4 border-top" style="border-color: var(--border-color) !important;">
                <a asp-action="Beneficiaries" class="btn-outline" style="flex: 1;">Cancelar</a>
                <button type="submit" class="btn-next" style="flex: 1;">Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }