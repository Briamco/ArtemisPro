@model Application.Models.ViewModels.Client.CashAdvanceViewModel
@{ 
    ViewData["Title"] = "Avance de Efectivo"; 
    Layout = "~/Views/Shared/_LayoutClient.cshtml"; 
}

<style>
    .form-card { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 30px; max-width: 600px; margin-top: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
    .custom-label { color: white; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; display: block; }
    .custom-input, .custom-select { background-color: #080D17; border: 1px solid var(--border-color); color: white; padding: 12px 16px; border-radius: 8px; width: 100%; outline: none; font-size: 1rem; }
    .custom-input:focus, .custom-select:focus { border-color: var(--cyan-accent); }
    .btn-next { background-color: var(--cyan-accent); color: #000; border: none; padding: 12px 30px; border-radius: 8px; font-weight: 600; cursor: pointer; width: 100%; margin-top: 20px;}
    .validation-summary-errors { background-color: rgba(255, 107, 107, 0.1); border: 1px solid #FF6B6B; color: #FF6B6B; border-radius: 8px; padding: 15px; margin-bottom: 20px; font-size: 0.85rem; list-style: none; }
    
    .info-box { background-color: rgba(0, 229, 255, 0.05); border: 1px solid rgba(0, 229, 255, 0.2); border-radius: 8px; padding: 15px; margin-top: 15px; }
</style>

<div>
    <h2 style="font-weight: 700; font-size: 2.2rem; margin-bottom: 5px;">Avance de Efectivo</h2>
    <p style="color: var(--text-muted);">Transfiere fondos instantáneamente desde tus tarjetas hacia tus cuentas.</p>

    <div class="form-card">
        
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" style="background-color: rgba(0, 229, 255, 0.1); border: 1px solid var(--cyan-accent); color: var(--cyan-accent); border-radius: 8px; padding: 15px; margin-bottom: 24px; display: flex; align-items: center; gap: 10px; font-weight: 600;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" style="background-color: rgba(255, 107, 107, 0.1); border: 1px solid #FF6B6B; color: #FF6B6B; border-radius: 8px; padding: 15px; margin-bottom: 24px; display: flex; align-items: center; gap: 10px; font-weight: 600;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                @TempData["ErrorMessage"]
            </div>
        }

        @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="validation-summary-errors"></div> }
        
        <form asp-action="CashAdvance" method="post">
            <div class="mb-4">
                <label class="custom-label" asp-for="CreditCardId">Tarjeta de crédito origen</label>
                <select asp-for="CreditCardId" class="custom-select">
                    <option value="">Seleccione una tarjeta...</option>
                    @foreach(var card in Model.MyActiveCards) { 
                        var disp = card.CreditLimit - card.DebtAmount;
                        <option value="@card.Id">Tarjeta @card.MaskedNumber - Disp: @disp.ToString("C")</option> 
                    }
                </select>
            </div>

            <div class="mb-4">
                <label class="custom-label" asp-for="AccountId">Cuenta de ahorro destino</label>
                <select asp-for="AccountId" class="custom-select">
                    <option value="">Seleccione una cuenta...</option>
                    @foreach(var acc in Model.MyActiveAccounts) { <option value="@acc.Id">@acc.AccountNumber - Saldo actual: @acc.Balance.ToString("C")</option> }
                </select>
            </div>

            <div class="mb-2">
                <label class="custom-label" asp-for="Amount">Monto del avance de efectivo (RD$)</label>
                <input asp-for="Amount" type="number" step="0.01" class="custom-input" placeholder="0.00" />
            </div>

            <div class="info-box d-flex gap-3 align-items-center">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--cyan-accent)" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                <div style="font-size: 0.8rem; color: var(--text-muted);">
                    Se aplicará un interés del <strong style="color: white;">6.25%</strong> sobre el monto solicitado. El monto total (avance + interés) se reflejará como deuda en su tarjeta y no puede superar su crédito disponible.
                </div>
            </div>

            <button type="submit" class="btn-next">Realizar avance</button>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }