@model Application.Models.ViewModels.Client.ConfirmTransactionBeneficiaryViewModel
@{ 
    ViewData["Title"] = "Confirmar Transacción"; 
    Layout = "~/Views/Shared/_LayoutClient.cshtml"; 
}

<div style="display: flex; align-items: center; justify-content: center; height: 100%;">
    <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 40px; text-align: center; max-width: 500px; width: 100%;">
        <div style="width: 70px; height: 70px; background-color: rgba(0, 229, 255, 0.1); border: 2px solid var(--cyan-accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto; color: var(--cyan-accent);">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </div>
        
        <h2 style="color: white; font-weight: 700; margin-bottom: 10px;">Confirmar Transacción</h2>
        <p style="color: var(--text-muted); font-size: 1.1rem; margin-bottom: 25px;">¿Está seguro de que desea realizar esta transacción?</p>
        
        <div style="background-color: #080D17; border: 1px solid var(--border-color); border-radius: 8px; padding: 20px; margin-bottom: 30px; text-align: left;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
                <span style="color: var(--text-muted); font-size: 0.85rem;">Beneficiario</span>
                <span style="color: white; font-weight: 600;">@Model.DestinationOwnerName</span>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
                <span style="color: var(--text-muted); font-size: 0.85rem;">Cuenta</span>
                <span style="color: white; font-family: monospace;">@Model.DestinationAccountNumber</span>
            </div>
            <div style="display: flex; justify-content: space-between; border-top: 1px solid var(--border-color); padding-top: 15px;">
                <span style="color: var(--text-muted); font-size: 0.85rem;">Monto a transferir</span>
                <span style="color: var(--cyan-accent); font-weight: 700; font-size: 1.2rem;">@Model.Amount.ToString("C")</span>
            </div>
        </div>

        <form asp-action="ExecuteTransactionBeneficiary" method="post" class="d-flex justify-content-center gap-3">
            <input type="hidden" asp-for="SourceAccountId" />
            <input type="hidden" asp-for="DestinationAccountNumber" />
            <input type="hidden" asp-for="Amount" />
            
            <a asp-action="Index" style="flex: 1; background-color: transparent; color: white; border: 1px solid var(--border-color); padding: 12px; border-radius: 8px; font-weight: 600; text-decoration: none;">Cancelar</a>
            <button type="submit" style="flex: 1; background-color: var(--cyan-accent); color: #000; border: none; padding: 12px; border-radius: 8px; font-weight: 600; cursor: pointer;">Confirmar</button>
        </form>
    </div>
</div>