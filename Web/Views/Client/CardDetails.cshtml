@model Application.Models.ViewModels.Client.ClientCardDetailsViewModel
@{
    ViewData["Title"] = "Detalles de Tarjeta";
    Layout = "~/Views/Shared/_LayoutClient.cshtml";
}

<style>
    .module-container { background-color: var(--bg-main); min-height: 100%; }
    
    .graphic-card { background-color: #2A303C; background-image: linear-gradient(135deg, #2A303C 0%, #1A1F29 100%); border-radius: 16px; padding: 25px; width: 380px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); position: relative; overflow: hidden; border: 1px solid rgba(255,255,255,0.05); }
    .graphic-card::before { content: ""; position: absolute; top: -50px; right: -50px; width: 150px; height: 150px; border-radius: 50%; background: rgba(255,255,255,0.02); }
    
    .card-number { font-family: 'Courier New', Courier, monospace; font-size: 1.5rem; color: white; letter-spacing: 3px; margin: 20px 0; font-weight: bold; }
    
    .table-container { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 25px; flex: 1; }
    .custom-table { width: 100%; color: white; border-collapse: separate; border-spacing: 0 10px; }
    .custom-table th { color: var(--text-muted); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; padding: 0 15px 10px 15px; border-bottom: 1px solid var(--border-color); }
    .custom-table td { padding: 15px; font-size: 0.9rem; vertical-align: middle; border-bottom: 1px solid rgba(255,255,255,0.03); }
    
    .badge-status { padding: 4px 10px; border-radius: 20px; font-size: 0.7rem; font-weight: 700;}
    .badge-aprobado { border: 1px solid var(--cyan-accent); color: var(--cyan-accent); }
    .badge-rechazado { border: 1px solid #FF6B6B; color: #FF6B6B; }
</style>

<div class="module-container">
    <div class="mb-4">
        <a asp-action="Index" style="color: white; text-decoration: none; display: flex; align-items: center; gap: 8px; margin-bottom: 20px; font-weight: 500;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg> Volver atrás
        </a>
        <h2 style="font-weight: 700; font-size: 2.2rem; color: white; margin-bottom: 5px;">Consumos de la Tarjeta</h2>
    </div>

    <div class="d-flex gap-4 align-items-start">
        
     
        <div>
            <div class="graphic-card">
                <div class="d-flex justify-content-between align-items-start">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0"></path><path d="M1.42 9a16 16 0 0 1 21.16 0"></path><path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path></svg>
                    <div style="text-align: right; font-size: 0.75rem; color: white; letter-spacing: 2px; font-weight: 600;">ARTEMIS ELITE</div>
                </div>
                
                <div class="card-number">@Model.MaskedNumber</div>
                
                <div style="border-top: 1px solid rgba(255,255,255,0.1); padding-top: 15px;">
                    <div style="font-size: 0.7rem; color: #8A92A6; text-transform: uppercase; letter-spacing: 1px;">Monto Adeudado</div>
                    <div style="font-size: 1.4rem; color: white; font-weight: 700;">@Model.DebtAmount.ToString("C")</div>
                </div>
            </div>
        </div>


        <div class="table-container">
            <h5 style="color: white; font-weight: 700; margin-bottom: 20px;">Historial de Consumos</h5>
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Fecha del consumo</th>
                        <th>Comercio</th>
                        <th>Monto consumido</th>
                        <th>Estado del consumo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var consumo in Model.Consumptions)
                    {
                        <tr>
                            <td style="color: var(--text-muted);">@consumo.Date.ToString("dd MMM yyyy, HH:mm")</td>
                            <td style="color: white;">@consumo.Commerce</td>
                            <td style="color: white; font-weight: 600;">@consumo.Amount.ToString("C")</td>
                            <td>
                                <span class="badge-status @(consumo.Status == "APROBADO" ? "badge-aprobado" : "badge-rechazado")">@consumo.Status</span>
                            </td>
                        </tr>
                    }
                    @if(!Model.Consumptions.Any())
                    {
                        <tr>
                            <td colspan="4" style="text-align: center; color: var(--text-muted); padding: 30px 0;">No hay consumos registrados para esta tarjeta.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
    </div>
</div>