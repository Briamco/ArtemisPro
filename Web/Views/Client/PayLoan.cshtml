@model Application.Models.ViewModels.Client.PayLoanViewModel
@{ ViewData["Title"] = "Pago de Préstamo"; Layout = "~/Views/Shared/_LayoutClient.cshtml"; }

<style>
    .form-card { background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 30px; max-width: 600px; margin-top: 20px;}
    .custom-label { color: white; font-size: 0.85rem; font-weight: 600; margin-bottom: 8px; display: block; }
    .custom-input, .custom-select { background-color: #080D17; border: 1px solid var(--border-color); color: white; padding: 12px 16px; border-radius: 8px; width: 100%; outline: none; font-size: 1rem; }
    .custom-input:focus, .custom-select:focus { border-color: var(--cyan-accent); }
    .btn-next { background-color: var(--cyan-accent); color: #000; border: none; padding: 12px 30px; border-radius: 8px; font-weight: 600; cursor: pointer; width: 100%; margin-top: 20px;}
    .validation-summary-errors { background-color: rgba(255, 107, 107, 0.1); border: 1px solid #FF6B6B; color: #FF6B6B; border-radius: 8px; padding: 15px; margin-bottom: 20px; font-size: 0.85rem; list-style: none; }
</style>

<div>
    <h2 style="font-weight: 700; font-size: 2.2rem; margin-bottom: 5px;">Pago de Préstamo</h2>
    <p style="color: var(--text-muted);">Abona a tus cuotas pendientes desde tus cuentas.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="background-color: rgba(0, 229, 255, 0.1); border: 1px solid var(--cyan-accent); color: var(--cyan-accent); border-radius: 8px; padding: 15px; margin-bottom: 24px; display: flex; align-items: center; gap: 10px; font-weight: 600;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="form-card">
        @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="validation-summary-errors"></div> }
        
        <form asp-action="PayLoan" method="post">
            <div class="mb-4">
                <label class="custom-label" asp-for="LoanId">Préstamo a pagar</label>
                <select asp-for="LoanId" class="custom-select">
                    <option value="">Seleccione un préstamo...</option>
                    @foreach(var l in Model.MyActiveLoans) { <option value="@l.Id">Préstamo No. @l.LoanNumber - Pend: @l.PendingAmount.ToString("C")</option> }
                </select>
            </div>

            <div class="mb-4">
                <label class="custom-label" asp-for="SourceAccountId">Cuenta de origen</label>
                <select asp-for="SourceAccountId" class="custom-select">
                    <option value="">Seleccione una cuenta...</option>
                    @foreach(var acc in Model.MyActiveAccounts) { <option value="@acc.Id">@acc.AccountNumber - Disp: @acc.Balance.ToString("C")</option> }
                </select>
            </div>

            <div class="mb-2">
                <label class="custom-label" asp-for="Amount">Monto a pagar (RD$)</label>
                <input asp-for="Amount" type="number" step="0.01" class="custom-input" placeholder="0.00" />
                <span style="font-size: 0.75rem; color: var(--text-muted); display: block; margin-top: 8px;">El pago se aplicará a la cuota pendiente más antigua.</span>
            </div>

            <button type="submit" class="btn-next">Pagar Préstamo</button>
        </form>
    </div>
</div>