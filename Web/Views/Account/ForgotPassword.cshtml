@model Application.Models.ViewModels.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer Contraseña";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<div class="text-center mb-4">
    <div class="d-inline-block p-2 rounded mb-3" style="background-color: rgba(0, 229, 255, 0.1);">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--cyan-accent)" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
    </div>
    <h3 class="font-weight-bold">Artemis Banking Pro</h3>
    <p class="text-white small" style="opacity: 0.9;">Accede a tu inteligencia financiera</p>
</div>

<div class="auth-container">
    <h4 class="mb-2" style="font-weight: 600;">Restablecer Contraseña</h4>
    <p class="mb-4" style="color: #8A99AF; font-size: 0.9rem; line-height: 1.5;">Introduce tu nombre de usuario para localizar tu cuenta y enviarte las instrucciones de recuperación.</p>

    <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()
        
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mb-4 text-center" style="color: var(--error-text); font-size: 0.85rem;">
                <div asp-validation-summary="All" class="m-0 list-unstyled"></div>
            </div>
        }

        <div class="form-group mb-4">
            <label asp-for="UserName" class="text-uppercase small font-weight-bold mb-2 d-block" style="color: #8A99AF; letter-spacing: 1px; font-size: 0.75rem;">Nombre de usuario</label>
            <div class="position-relative">
                <span class="position-absolute" style="top: 12px; left: 15px; color: #6B7A90;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                </span>
                <input asp-for="UserName" class="form-control" style="padding-left: 45px;" placeholder="p. ej. artemis_user" required />
            </div>
        </div>

        <button type="submit" class="btn-primary-neon mb-4 d-flex justify-content-center align-items-center gap-2">
            Enviar solicitud
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </button>
        
        <div class="text-center">
            <a asp-action="Login" style="color: var(--cyan-accent); text-decoration: none; font-size: 0.9rem; font-weight: 500;">
                &larr; Volver al inicio de sesión
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}