@model Application.Models.ViewModels.Account.NewPasswordViewModel
@{
    ViewData["Title"] = "Establecer Nueva Contraseña";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<div class="text-center mb-4">
    <div class="d-inline-block p-2 rounded mb-3" style="background-color: rgba(0, 229, 255, 0.1);">
         <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--cyan-accent)" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
    </div>
    <h3 class="font-weight-bold">Artemis Banking Pro</h3>
    <p class="text-white small" style="opacity: 0.9;">Accede a tu inteligencia financiera</p>
</div>

<div class="auth-container">
    <h4 class="mb-2" style="font-weight: 600;">Establecer Nueva Contraseña</h4>
    <p class="mb-4" style="color: #8A99AF; font-size: 0.9rem; line-height: 1.5;">Proteja sus activos con una frase de contraseña de alta entropía.</p>

    <form asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()
        
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mb-4 text-center" style="color: var(--error-text); font-size: 0.85rem;">
                <div asp-validation-summary="All" class="m-0 list-unstyled"></div>
            </div>
        }

        <div class="form-group mb-3">
            <label asp-for="Password" class="text-uppercase small font-weight-bold mb-2 d-block" style="color: #8A99AF; letter-spacing: 1px; font-size: 0.75rem;">Nueva Contraseña</label>
            <div class="position-relative">
                <span class="position-absolute" style="top: 12px; left: 15px; color: #6B7A90;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                </span>
                <input asp-for="Password" type="password" class="form-control" style="padding-left: 45px;" placeholder="••••••••" required />
            </div>
        </div>

        <div class="form-group mb-4">
            <label asp-for="ConfirmPassword" class="text-uppercase small font-weight-bold mb-2 d-block" style="color: #8A99AF; letter-spacing: 1px; font-size: 0.75rem;">Confirmar Contraseña</label>
            <div class="position-relative">
                <span class="position-absolute" style="top: 12px; left: 15px; color: #6B7A90;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                </span>
                <input asp-for="ConfirmPassword" type="password" class="form-control" style="padding-left: 45px;" placeholder="••••••••" required />
            </div>
        </div>

        <div class="d-flex justify-content-between mb-4 gap-2">
            <div style="background-color: rgba(255,255,255,0.05); border-radius: 20px; padding: 5px 10px; font-size: 0.7rem; color: #8A99AF; flex: 1; text-align: center;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-1"><polyline points="20 6 9 17 4 12"></polyline></svg> 8+ Caracteres
            </div>
            <div style="background-color: rgba(255,255,255,0.05); border-radius: 20px; padding: 5px 10px; font-size: 0.7rem; color: #8A99AF; flex: 1; text-align: center;">
                 <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-1"><polyline points="20 6 9 17 4 12"></polyline></svg> Símbolo/Número
            </div>
        </div>

        <button type="submit" class="btn-primary-neon mb-4 d-flex justify-content-center align-items-center gap-2">
            Restablecer Contraseña
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </button>
        
        <div class="text-center">
            <a asp-action="Login" style="color: var(--cyan-accent); text-decoration: none; font-size: 0.9rem; font-weight: 500;">
                &larr; Volver al inicio de sesión
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}