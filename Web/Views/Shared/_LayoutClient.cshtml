<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Artemis Pro Cliente</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --bg-main: #0B101E; 
            --bg-sidebar: #080D17;
            --bg-card: #141C2B;
            --cyan-accent: #00E5FF;
            --text-main: #FFFFFF;
            --text-muted: #8A99AF;
            --border-color: #1F2A3D;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        .sidebar {
            width: 280px;
            background-color: var(--bg-sidebar);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            padding: 25px 20px;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border-color);
        }

        .nav-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            flex-grow: 1;
            overflow-y: auto;
        }

        .nav-item {
            margin-bottom: 8px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 15px;
            color: var(--text-muted);
            text-decoration: none;
            padding: 12px 15px;
            border-radius: 8px;
            transition: all 0.3s ease;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .nav-link:hover, .nav-link.active {
            background-color: rgba(0, 229, 255, 0.1);
            color: var(--cyan-accent);
        }

        .nav-link svg {
            width: 20px;
            height: 20px;
        }

        .sub-menu-title { 
            font-size: 0.7rem; 
            color: #4A5568; 
            text-transform: uppercase; 
            letter-spacing: 1px; 
            padding: 15px 15px 5px 15px; 
            font-weight: 700; 
        }

        .logout-btn {
            color: #FF6B6B;
            margin-top: auto;
        }
        .logout-btn:hover {
            background-color: rgba(255, 107, 107, 0.1);
            color: #FF8787;
        }

        .main-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        .topbar {
            height: 70px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 0 30px;
            background-color: var(--bg-main);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .content-area {
            padding: 30px;
        }
    </style>
</head>
<body>
    
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="d-inline-flex p-2 rounded" style="background-color: rgba(0, 229, 255, 0.1);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--cyan-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 21h18"></path><path d="M3 10h18"></path><path d="M5 6l7-3 7 3"></path><path d="M4 10v11"></path><path d="M20 10v11"></path><path d="M8 14v3"></path><path d="M12 14v3"></path><path d="M16 14v3"></path>
                </svg>
            </div>
            Artemis Banking Pro
        </div>

        <ul class="nav-menu">
            @{ var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? ""; }

            <li class="nav-item">
                <a asp-controller="Client" asp-action="Index" class="nav-link @(currentAction == "Index" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                    Home
                </a>
            </li>

            <div class="sub-menu-title">Operaciones</div>

            <li class="nav-item">
                <a data-bs-toggle="collapse" href="#transaccionesMenu" role="button" aria-expanded="@(currentAction.Contains("Transaction") || currentAction.Contains("Pay") ? "true" : "false")" aria-controls="transaccionesMenu" class="nav-link @(currentAction.Contains("Transaction") || currentAction.Contains("Pay") ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg> 
                    Transacciones
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left: auto;"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </a>
                <div class="collapse @(currentAction.Contains("Transaction") || currentAction.Contains("Pay") ? "show" : "")" id="transaccionesMenu">
                    <ul style="list-style: none; padding-left: 20px; margin-top: 5px; border-left: 1px solid rgba(255,255,255,0.05); margin-left: 30px;">
                        <li class="nav-item"><a asp-controller="Client" asp-action="TransactionExpress" class="nav-link" style="padding: 8px 15px; font-size: 0.85rem;">Transacciones - Express</a></li>
                        <li class="nav-item"><a asp-controller="Client" asp-action="PayCreditCard" class="nav-link" style="padding: 8px 15px; font-size: 0.85rem;">Transacciones - Tarjeta de crédito</a></li>
                        <li class="nav-item"><a asp-controller="Client" asp-action="PayLoan" class="nav-link" style="padding: 8px 15px; font-size: 0.85rem;">Transacciones - Préstamo</a></li>
                        <li class="nav-item"><a asp-controller="Client" asp-action="TransactionBeneficiary" class="nav-link" style="padding: 8px 15px; font-size: 0.85rem;">Transacciones - Beneficiarios</a></li>
                    </ul>
                </div>
            </li>

            <li class="nav-item">
                <a asp-controller="Client" asp-action="Beneficiaries" class="nav-link @(currentAction.Contains("Beneficiary") && !currentAction.Contains("Transaction") ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg> Beneficiarios
                </a>
            </li>
           <li class="nav-item">
                <a asp-controller="Client" asp-action="CashAdvance" class="nav-link @(currentAction == "CashAdvance" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h20"></path><path d="M20 12v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"></path><path d="M4 12v-4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4"></path></svg> 
                    Avance de efectivo
                </a>
            </li>
            
            <li class="nav-item">
                <a href="#" class="nav-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3L12 7L8 11"></path><path d="M12 7H4V21H20V7H16"></path></svg> Transferencia</a>
            </li>
        </ul>
         

        <form asp-controller="Account" asp-action="Logout" method="post" style="margin-top: auto;">
            @Html.AntiForgeryToken()
            <button type="submit" class="nav-link logout-btn" style="background: none; border: none; width: 100%; text-align: left; cursor: pointer;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                Cerrar sesión
            </button>
        </form>
    </aside>

    <main class="main-content">
        <header class="topbar">
            <div style="display: flex; align-items: center; gap: 15px;">
                <div style="width: 38px; height: 38px; background: rgba(0,229,255,0.15); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--cyan-accent); font-weight: bold; border: 1px solid rgba(0,229,255,0.3);">
                    C
                </div>
                <div>
                    <span style="font-size: 0.8rem; color: var(--text-muted); display: block; line-height: 1; margin-bottom: 3px;">Cliente Regular</span>
                    <strong style="font-size: 0.95rem;">@(User.Identity?.Name ?? "Carlos Mendoza")</strong>
                </div>
            </div>
        </header>

        <section class="content-area">
            @RenderBody()
        </section>
    </main>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>